{
  "Minecraft": {
    "Host": "cookie-smp.minetro.net",
    "Port": 25565,
    "TimeoutMs": 5000
  },

  "Mysql": {
    "Host": "SET_VIA_ENV_OR_USER_SECRETS",
    "Port": 3306,
    "Database": "SET_VIA_ENV_OR_USER_SECRETS",
    "Username": "SET_VIA_ENV_OR_USER_SECRETS",
    "Password": "SET_VIA_ENV_OR_USER_SECRETS",
    "PollIntervalSeconds": 60
  },

  "Leaderboards": {
    "Sources": [
      { "Category": "kills", "TableName": "ajlb_statistic_player_kills", "NameColumn": "name", "ValueColumn": "value", "NumberFormat": "N0" },
      { "Category": "deaths", "TableName": "ajlb_statistic_deaths", "NameColumn": "name", "ValueColumn": "value", "NumberFormat": "N0" },
      { "Category": "playtime", "TableName": "ajlb_statistic_time_played", "NameColumn": "name", "ValueColumn": "value", "NumberFormat": "duration", "Divisor": 20 },
      { "Category": "mobKills", "TableName": "ajlb_statistic_mob_kills", "NameColumn": "name", "ValueColumn": "value", "NumberFormat": "N0" },
      { "Category": "brokenBlocks", "TableName": "ajlb_statistic_mine_block", "NameColumn": "name", "ValueColumn": "value", "NumberFormat": "N0" }
    ]
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
